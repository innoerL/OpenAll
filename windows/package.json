{
  "name": "openall-windows",
  "productName": "OpenAll",
  "version": "0.27.9",
  "description": "OpenAll Windows 效率工具",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "build:editors": "node scripts/build-editors.js",
    "test": "node scripts/test.js",
    "test:gold": "electron test/gold-integration.js",
    "check": "node scripts/check.js",
    "smoke": "electron ."
  },
  "dependencies": {
    "icodec": "0.6.0",
    "marked": "^15.0.12",
    "pinyin-pro": "3.29.5",
    "sql.js": "^1.13.0",
    "utif": "3.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.openall.windows",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/editor-test.*"
    ],
    "extraResources": [
      {
        "from": "../shared/manual-ui",
        "to": "shared/manual-ui",
        "filter": ["reader.js", "reader.css"]
      },
      {
        "from": "../shared/gold-core",
        "to": "gold-core",
        "filter": [
          "*.cjs"
        ]
      },
      {
        "from": "../shared/gold-ui",
        "to": "gold-ui",
        "filter": [
          "index.html",
          "style.css",
          "theme.js",
          "renderer.js",
          "chart.js",
          "surface-effects.js",
          "surface-effects.css"
        ]
      },
      {
        "from": "../shared/gold-ui",
        "to": "shared/gold-ui",
        "filter": [
          "surface-effects.js",
          "surface-effects.css"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "OpenAll-Windows-${version}-${arch}-setup.${ext}",
    "asarUnpack": [
      "src/native-*.ps1",
      "src/native-*.js",
      "node_modules/icodec/**/*",
      "node_modules/utif/**/*",
      "node_modules/pako/**/*"
    ]
  }
}
